<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the request is for an existing file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Remove index.php from all URLs — route everything through CI front controller
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# Deny direct access to application/ and system/ directories
<FilesMatch "^\.">
    # Apache 2.4+
    <IfVersion >= 2.4>
        Require all denied
    </IfVersion>
    # Apache 2.2
    <IfVersion < 2.4>
        Order allow,deny
        Deny from all
    </IfVersion>
</FilesMatch>
