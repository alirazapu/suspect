# Use 'production' on the server. Using 'development' requires a full
# 'composer install' (not --no-dev) to load the Kint debug library.
CI_ENVIRONMENT = production

app.baseURL = 'http://ctd.suspect.kpk/'

database.default.hostname = localhost
database.default.database = aiesplus
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi

# Must match the hash_key value in dramslive application/config/auth.php
# Without this, users from the aies/dramslive system cannot log in.
DRAMS_HASH_KEY =

# Shared SSO secret (reserved for future HMAC validation)
SSO_SECRET =

# PID encryption key and IV (must remain consistent across deployments)
PID_SECRET_KEY = 'Irfan love CTD'
PID_SECRET_IV  = 'SEStoPakistan'
