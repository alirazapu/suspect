{
    "name": "suspect/app",
    "description": "Suspect - Person Intelligence Portal",
    "type": "project",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.5.0 <4.6.0",
        "cweagans/composer-patches": "^1.7"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "scripts": {
        "post-update-cmd": [
            "CodeIgniter\\ComposerScripts::postUpdate"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "codeigniter4/devkit": true,
            "cweagans/composer-patches": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "extra": {
        "patches": {
            "codeigniter4/framework": {
                "CVE-2025-54418: Fix command injection in ImageMagickHandler (_resize, _text, process)": "patches/imagick-handler-command-injection.patch"
            }
        }
    },
    "audit": {
        "ignore": [
            "PKSA-7ybs-j1bv-y5mc",
            "PKSA-qbjf-dc24-wrff"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
