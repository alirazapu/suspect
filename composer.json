{
    "name": "suspect/app",
    "description": "Suspect - Person Intelligence Portal",
    "type": "project",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.5.0 <4.6.0"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "codeigniter4/devkit": true
        },
        "audit": {
            "ignore": [
                "PKSA-7ybs-j1bv-y5mc",
                "PKSA-qbjf-dc24-wrff"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
