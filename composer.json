{
    "name": "suspect/app",
    "description": "Suspect - Person Intelligence Portal",
    "type": "project",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.6.2"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "codeigniter4/devkit": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
